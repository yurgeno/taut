{
  // Stage 4 (TS-on-Node, owner GO 2026-08-15): the compiler core is TypeScript executed
  // NATIVELY by Node >= 24 (type stripping) — no build step, no dist/, zero runtime deps.
  // tsc is a CHECKER only (noEmit) — `npm test` runs it before the suite.
  // Typechecked: lib/**/*.mts. Deliberately outside: taut.mjs (thin plain-JS CLI shell),
  // gate/*.mjs (SHIPPED self-contained artifacts — run on any workspace Node),
  // test/**/*.mjs (the behavioral suite — unchanged tests prove unchanged behavior).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.mts"]
}
